# Server Environment Variables
PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brightloop_sub?schema=public"
JWT_SECRET="super-secret-jwt-key-brightloop-123456789"
JWT_EXPIRES_IN="7d"
FRONTEND_URL="http://localhost:5173"

# Mailer Configuration (SMTP) - Defaults to ethereal / console logger if not provided
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Brightloop Software <no-reply@brightloop.com>"

# Client Environment Variables (for Vite)
VITE_API_BASE_URL="http://localhost:5000/api"
